{
  "trailingSlash": true,
  "redirects": [
    { "source": "/pool-models.html", "destination": "/fiberglass-pools/", "statusCode": 301 },
    { "source": "/pool-models", "destination": "/fiberglass-pools/", "statusCode": 301 },
    { "source": "/pool-models/", "destination": "/fiberglass-pools/", "statusCode": 301 },
    { "source": "/get-a-quote.html", "destination": "/free-3d-design/", "statusCode": 301 },
    { "source": "/get-a-quote", "destination": "/free-3d-design/", "statusCode": 301 },
    { "source": "/get-a-quote/", "destination": "/free-3d-design/", "statusCode": 301 },
    { "source": "/services.html", "destination": "/why-itop/", "statusCode": 301 },
    { "source": "/services", "destination": "/why-itop/", "statusCode": 301 },
    { "source": "/services/", "destination": "/why-itop/", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
